# Copy this file to .env and fill it. NEVER commit .env.

# Sepolia RPC endpoint (Alchemy, Infura, or the public https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC=

# Wallet 1: deployer and contract owner (only this wallet can mint)
PRIVATE_KEY=
# Wallet 2: a regular user, used to demonstrate transfers and refused privileges
PRIVATE_KEY2=

# Your 42 login, written as the artist in every metadata
ARTIST_LOGIN=

# Pinata JWT (https://app.pinata.cloud -> API Keys) used by `make ipfs-upload`
PINATA_JWT=

# Etherscan API key, used by `make verify` / `make onchain-verify`
ETHERSCAN_API_KEY=
